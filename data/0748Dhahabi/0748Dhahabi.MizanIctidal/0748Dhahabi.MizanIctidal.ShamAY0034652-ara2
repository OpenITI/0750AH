# مجهول.
PageV05P285
# 9847- أبو محمد البصري.
# عن نعيم بن أبي هند، كذلك.
PageV05P285
# 9848- أبو محمد.
# عن الحسن البصري.
# حدث عنه جرير، كذلك.
PageV05P285
# 9849- أبو محمد.
