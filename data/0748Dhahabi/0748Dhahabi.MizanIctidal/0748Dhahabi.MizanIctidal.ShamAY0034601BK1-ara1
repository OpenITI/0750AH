# وقال موسى بن هارون لا يعرف
# قلت روى عنه ثور ويحيى بن جابر وسليمان بن سليم وقد وثق
# 3842 [ 4237 ] - صالح العبدي
# عن ابن سيرين
PageV03P417
# 3843 [ 4238 ] - وصال السلمي عن أبي الشعثاء مجهولان
# 3844 [ 4239 ] - وصالح الشيباني
# وقال ابن المديني مجهول
